<mjml lang="fr">
  <mj-head>
    <mj-title>Votre session Memoria approche</mj-title>
    <mj-preview>Le Pensionnat de la Liberté vous attend le {{var:bookingStartDateFull:""}} à {{var:bookingStartTime:""}}.</mj-preview>
    <mj-include path="./_tete.mjml" />
  </mj-head>
  <mj-body background-color="#0b0b0b" width="600px">
    <mj-include path="./_entete.mjml" />
    <mj-wrapper background-color="#141111" border-top="3px solid #8a1316" padding="0">
      <mj-section>
        <mj-column>
          <mj-image src="https://memoria-experience.fr/images/mails/bandeau-pensionnat.jpg" alt="" padding="0" />
          <mj-text mj-class="titre">LE PENSIONNAT VOUS ATTEND</mj-text>
          <mj-divider border-color="#a9851a" border-width="1px" width="70px" padding="6px 0 24px" />
          <mj-text>Bonjour {{var:booking.customer.user.name.given_name:""}},</mj-text>
          <mj-text padding="12px 32px 0">Le grand jour approche. Votre session est prévue le :</mj-text>
          <mj-text mj-class="date" padding="18px 32px 22px">{{var:bookingStartDateFull:""}}<br>à {{var:bookingStartTime:""}}</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0 32px 22px">
        <mj-column background-color="#1a1515" padding="18px 22px">
          <mj-text padding="0" font-size="16px" line-height="1.7"><span class="libelle">Joueurs</span>&nbsp;&nbsp;{{var:booking.room_players:""}}<br><span class="libelle">Au nom de</span>&nbsp;&nbsp;{{var:booking.customer.user.name.full:""}}<br><span class="libelle">Commande</span>&nbsp;&nbsp;{{var:booking.order.reference:""}}</mj-text>
          <mj-button href='{{var:bookingResumeLink:"https://memoria-experience.fr/"}}' padding="16px 0 0" align="left">Voir ma réservation</mj-button>
        </mj-column>
      </mj-section>
      <mj-include path="./_mot-de-passe.mjml" />
      <mj-include path="./_intensite.mjml" />
      <mj-include path="./_pratique.mjml" />
      <mj-section padding="22px 0 34px">
        <mj-column>
          <mj-text>Respirez profondément. Et surtout… restez groupés.</mj-text>
          <mj-text padding="12px 32px 0" font-family="Metamorphous, Georgia, serif" color="#ece6da">L’équipe Memoria</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-include path="./_pied.mjml" />
  </mj-body>
</mjml>
